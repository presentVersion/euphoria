# ==============================================================================
# SMART PATIENT QUEUE & EMERGENCY TRIAGE - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL PASSWORDS OR PRODUCTION SECRETS TO REPOSITORY VERSION CONTROL
# ==============================================================================

# Runtime Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgres://triage_admin:triage_secure_dev_pass@localhost:5432/triage_db

# Cryptographic Session Secrets (Generate 64+ char random strings for production)
JWT_SECRET=dev-insecure-jwt-secret-min-32-chars-key-change-in-production!
COOKIE_SECRET=dev-insecure-cookie-secret-min-32-chars-change-in-production!

# CORS & Gateway
CORS_ORIGIN=http://localhost:3000

# Clinical Triage Governance
# In production, must be set to a committee-approved protocol code
ACTIVE_TRIAGE_PROTOCOL=DEMO-PROTOCOL-v1

# Security & Audit
AUDIT_LOG_ENABLED=true
RATE_LIMIT_MAX_REQ=120

# Real-Time Event Hub
SSE_HEARTBEAT_INTERVAL_MS=15000

# Hospital / Facility Identifier
DEFAULT_FACILITY_ID=f1a2b3c4-1111-2222-3333-444455556666

# Audio Alarm System (IEC 60601-1-8 medical alerts)
ENABLE_AUDIO_ALARMS=true
